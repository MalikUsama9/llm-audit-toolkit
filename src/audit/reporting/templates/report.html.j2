{% macro pct(k, n) -%}{% if n %}{{ "%.1f"|format(100 * k / n) }}% <span class="kn">({{ k }} of {{ n }})</span>{% else %}n/a{% endif %}{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>LLM Audit Report - {{ meta.run_id }}</title>
    <link rel="stylesheet" href="report.css">
    <style>
        @page {
            size: A4;
            margin: 20mm 15mm 20mm 15mm;
            @bottom-right {
                content: "Page " counter(page) " of " counter(pages);
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                font-size: 9pt;
                color: #718096;
            }
            @bottom-left {
                content: "LLM Audit Toolkit — Confidential";
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                font-size: 9pt;
                color: #718096;
            }
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #2D3748;
            line-height: 1.6;
            font-size: 10.5pt;
            margin: 0;
            padding: 0;
            background: #ffffff;
        }
        
        /* Header Banner */
        .header-container {
            border-bottom: 2px solid #3182CE;
            padding-bottom: 12px;
            margin-bottom: 24px;
        }
        h1 {
            font-size: 24pt;
            color: #1A202C;
            margin: 0 0 6px 0;
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .meta-bar {
            font-size: 9.5pt;
            color: #4A5568;
            background: #EDF2F7;
            padding: 8px 12px;
            border-radius: 6px;
            margin-top: 8px;
        }
        .meta-bar code,
        table.data-table code {
            font-family: Consolas, monospace;
            background: #E2E8F0;
            padding: 2px 4px;
            border-radius: 3px;
            font-size: 8.5pt;
        }

        /* Section Headings */
        h2 {
            font-size: 14pt;
            color: #2B6CB0;
            border-bottom: 1px solid #E2E8F0;
            padding-bottom: 6px;
            margin-top: 28px;
            margin-bottom: 12px;
            font-weight: 600;
            page-break-after: avoid;
        }
        p {
            margin: 0 0 12px 0;
        }

        /* KPI Grid layout */
        .kpi-grid {
            width: 100%;
            border-collapse: separate;
            border-spacing: 12px 0;
            margin-left: -12px;
            margin-right: -12px;
            margin-bottom: 16px;
        }
        .kpi-card {
            background: #F7FAFC;
            border: 1px solid #E2E8F0;
            border-top: 3px solid #3182CE;
            border-radius: 6px;
            padding: 14px 16px;
            vertical-align: top;
            width: 50%;
        }
        .kpi-title {
            font-size: 9pt;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #718096;
            font-weight: 600;
            margin-bottom: 4px;
        }
        .kpi-value {
            font-size: 20pt;
            font-weight: 700;
            color: #1A202C;
            line-height: 1.2;
        }
        .kpi-sub {
            font-size: 9pt;
            color: #4A5568;
            margin-top: 4px;
        }

        /* Data Tables */
        table.data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 16px;
            font-size: 10pt;
        }
        table.data-table th {
            background: #EDF2F7;
            color: #2D3748;
            font-weight: 600;
            text-align: left;
            padding: 8px 10px;
            border-bottom: 2px solid #CBD5E0;
        }
        table.data-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #E2E8F0;
            color: #4A5568;
            vertical-align: top;
        }
        table.data-table tr:nth-child(even) td {
            background: #F9FAFB;
        }

        /* Badges & Highlights */
        .badge {
            display: inline-block;
            padding: 2px 8px;
            font-size: 8.5pt;
            font-weight: 600;
            border-radius: 12px;
            background: #E2E8F0;
            color: #4A5568;
        }
        .badge-draft {
            background: #FEFCBF;
            color: #975A16;
            border: 1px solid #F6E05E;
        }
        .muted {
            color: #718096;
            font-style: italic;
        }
        .kn {
            font-size: 8.5pt;
            color: #718096;
            font-weight: normal;
        }
        ul {
            margin: 0 0 12px 0;
            padding-left: 20px;
        }
        li {
            margin-bottom: 6px;
        }
    </style>
</head>
<body>

    <div class="header-container">
        <h1>LLM Audit Report</h1>
        <div class="meta-bar">
            <strong>Target:</strong> {{ run.target }} &nbsp;|&nbsp; 
            <strong>Run ID:</strong> <code>{{ run.run_id }}</code> &nbsp;|&nbsp; 
            <strong>Judge:</strong> {{ run.judge_model }}
        </div>
    </div>

    <!-- Executive Summary -->
    <h2>Executive Summary</h2>
    <table class="kpi-grid">
        <tr>
            <td class="kpi-card">
                <div class="kpi-title">Overall Performance</div>
                <div class="kpi-value">
                    {% if overall and overall.n %}
                        {{ pct(overall.passed, overall.n) }}
                    {% else %}
                        -
                    {% endif %}
                </div>
                <div class="kpi-sub">Evaluated across {{ counts.judged | default(0) }} judged benchmark cases</div>
            </td>
            <td class="kpi-card" style="border-top-color: #4FD1C5;">
                <div class="kpi-title">Latency Profile</div>
                <div class="kpi-value" style="font-size: 16pt; padding-top: 4px;">
                    p50: {{ latency.p50_ms | default('N/A') }} ms
                </div>
                <div class="kpi-sub">p95 Latency: {{ latency.p95_ms | default('N/A') }} ms</div>
            </td>
        </tr>
    </table>

    <!-- Methodology -->
    <h2>Methodology</h2>
    <p>This automated evaluation audited <strong>{{ run.target }}</strong> using execution configuration <code>{{ run.run_id }}</code> against standard benchmark test distributions to quantify accuracy, instruction-following stability, and failure vectors.</p>

    <!-- Scores by Category -->
    <h2>Scores by Category</h2>
    {% if categories %}
    <table class="data-table">
        <thead>
            <tr>
                <th style="width: 45%;">Category</th>
                <th style="width: 30%;">Passed / Total</th>
                <th style="width: 25%;">Success Rate</th>
            </tr>
        </thead>
        <tbody>
            {% for name, cat in categories.items() %}
            <tr>
                <td><strong>{{ name }}</strong></td>
                <td>{{ cat.passed | default(0) }} / {{ cat.n | default(0) }}</td>
                <td><strong>{{ pct(cat.passed | default(0), cat.n | default(0)) }}</strong></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p class="muted">No category breakdown available for this execution run.</p>
    {% endif %}

    <!-- Recommended Fixes -->
    <section class="recommendations">
        <h2>Recommended Fixes & Draft Action Plan</h2>
        <p class="muted">The following AI-drafted recommendations and estimated efforts require engineer review prior to external client delivery.</p>
        {% if recommendations %}
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 26%;">Failure Category</th>
                    <th style="width: 8%;">Cases</th>
                    <th style="width: 16%;">Expected Effort</th>
                    <th style="width: 50%;">LLM-Drafted Fix & Review Status</th>
                </tr>
            </thead>
            <tbody>
                {% for rec in recommendations %}
                <tr>
                    <td><strong>{{ rec.category }}</strong></td>
                    <td><span class="badge">{{ rec.count }}</span></td>
                    <td><code>{{ rec.expected_effort }}</code></td>
                    <td>
                        <div>{{ rec.recommendation }}</div>
                        <div style="margin-top: 6px;">
                            <span class="badge badge-draft">{{ rec.status }}</span>
                        </div>
                        {% if rec.examples %}
                        <div class="kn" style="margin-top: 4px;">
                            Sample IDs: {% for ex in rec.examples %}<code>{{ ex }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
                        </div>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="muted">No failures detected. Great job!</p>
        {% endif %}
    </section>

<section class="does-well">
  <h2>What the Bot Does Well</h2>
  {% set ns = namespace(found=false) %}
  <ul>
  {% for name, c in categories.items() if c.n and c.rate is not none and c.rate >= 0.8 %}
    {% set ns.found = true %}
    <li><strong>{{ name | replace('_', ' ') | title }}</strong>:
        {{ pct(c.passed, c.n) }}
        (95% CI {{ "%.0f"|format(c.ci_low * 100) }}% to {{ "%.0f"|format(c.ci_high * 100) }}%)
        {% if c.small_sample %}<em>- small sample, indicative only</em>{% endif %}</li>
  {% endfor %}
  </ul>
  {% if not ns.found %}<p>No category reached 80% in this run.</p>{% endif %}
</section>

<section class="failure-patterns">
  <h2>Top Failure Patterns</h2>
  {% if failures %}
  <table>
    <tr><th>Case</th><th>Category</th><th>Question</th><th>Bot answer</th><th>Judge reasoning</th></tr>
    {% for f in failures[:10] %}
    <tr>
      <td>{{ f.case_id }}</td>
      <td>{{ f.category | replace('_', ' ') }}</td>
      <td>{{ f.question }}</td>
      <td>{{ (f.answer or '') | truncate(250) }}</td>
      <td>{{ (f.reasoning or '') | truncate(250) }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p>No failed cases in this run.</p>
  {% endif %}
</section>

    <section class="calibration">
  <h2>Judge Calibration</h2>
  {% if calibration and calibration.n %}
  <p>The automated judge was compared with human labels on {{ calibration.n }} cases.
     They agreed on {{ calibration.agree }} of {{ calibration.n }}
     ({{ "%.1f"|format(calibration.agreement * 100) }}%,
     95% CI {{ "%.1f"|format(calibration.agreement_ci[0] * 100) }}% to
     {{ "%.1f"|format(calibration.agreement_ci[1] * 100) }}%).
     Cohen's kappa: {{ "%.2f"|format(calibration.kappa) }}.</p>
  <table>
    <tr><th>Human label / Judge label</th>
      {% for l in calibration.labels %}<th>{{ l }}</th>{% endfor %}</tr>
    {% for row in calibration.labels %}
    <tr><th>{{ row }}</th>
      {% for col in calibration.labels %}<td>{{ calibration.confusion[row][col] }}</td>{% endfor %}</tr>
    {% endfor %}
  </table>
  <p><em>{{ calibration.note }}</em></p>
  {% else %}
  <p>No human-labeled cases were available, so judge accuracy is unverified.</p>
  {% endif %}
</section>

<section class="cost">
  <h2>Cost and Latency</h2>
  <table>
    <tr><th>Latency p50</th><td>{{ latency.p50_ms | default('N/A') }} ms</td></tr>
    <tr><th>Latency p95</th><td>{{ latency.p95_ms | default('N/A') }} ms</td></tr>
    <tr><th>Input tokens</th><td>{{ usage.input_tokens }}</td></tr>
    <tr><th>Output tokens</th><td>{{ usage.output_tokens }}</td></tr>
    <tr><th>Estimated cost</th><td>{{ usage.est_cost_usd if usage.est_cost_usd is not none else 'not available' }}</td></tr>
    <tr><th>Cost per answer</th><td>{{ usage.est_cost_per_answer_usd if usage.est_cost_per_answer_usd is not none else 'not available' }}</td></tr>
  </table>
</section>
    <!-- Limitations -->
    <h2>Limitations & Caveats</h2>
    {% if limitations %}
    <ul>
        {% for limit in limitations %}
        <li>{{ limit }}</li>
        {% endfor %}
    </ul>
    {% else %}
    <p class="muted">Automated benchmark audits serve as a high-fidelity evaluation baseline. Human verification remains critical for domain-specific nuance, safety edge cases, and real-world deployment alignment.</p>
    {% endif %}

</body>
</html>